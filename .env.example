# subrosa runtime configuration. Copy to .env and fill in; .env stays untracked.
SUBROSA_NETWORK=testnet

# NEAR RPC endpoint for reads and transaction submission.
NEAR_RPC_URL=https://rpc.testnet.near.org

# Deployed subrosa contract account.
SUBROSA_CONTRACT=subrosa.testnet

# 1Click (Confidential Intents) API base URL.
ONECLICK_BASE_URL=https://1click.chaindefuser.com

# 1Click partner JWT. Server-side only; never commit it.
ONECLICK_API_KEY=

# Development signing key, dev environments only. Server-side only; never commit it.
SUBROSA_DEV_KEY=

# Optional snarkjs artifact overrides.
WASM_URL=
ZKEY_URL=

# Artifact cache lifetime in seconds.
ARTIFACT_CACHE_TTL=86400

# Local export/statement store; git-ignored.
SUBROSA_STORE_PATH=.subrosa/private-store.json
