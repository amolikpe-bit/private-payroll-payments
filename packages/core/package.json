{
  "name": "near-subrosa-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "near-api-js": "7.5.3",
    "@defuse-protocol/one-click-sdk-typescript": "0.1.26",
    "@defuse-protocol/intents-sdk": "0.96.0",
    "near-social-js": "2.0.4",
    "@hot-labs/near-connect": "0.12.0",
    "snarkjs": "0.7.6",
    "axios": "1.21.1"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "^22.0.0"
  },
  "engines": {
    "node": ">=22.22.2",
    "npm": ">=10.4.1"
  }
}
