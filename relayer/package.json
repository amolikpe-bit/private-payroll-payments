{
  "name": "near-subrosa-relayer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "NEP-366 meta-transaction relayer for the subrosa.testnet payroll contract",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "subrosa-relayer": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "npm run build:test && node --test dist-test/test/*.test.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "node -e \"const fs=require('fs'); for (const d of ['dist','dist-test']) fs.rmSync(d,{recursive:true,force:true})\"",
    "start": "node dist/cli.js serve"
  },
  "dependencies": {
    "near-api-js": "7.5.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
